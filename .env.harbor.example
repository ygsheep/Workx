# Workx 跑分环境变量 —— 本地用，切勿提交（.gitignore 已排除 .env.harbor）
#
# WORKX_BASE_URL：模型 API 端点。
#   官方 DeepSeek：https://api.deepseek.com
#   也可填完整端点（如自建/第三方中转）：https://<host>/v1/chat/completions
#   两种写法都支持（客户端会自动补 /chat/completions，已含则不重复追加）。
#   留空则用默认 https://api.deepseek.com。
WORKX_BASE_URL=https://api.deepseek.com
WORKX_API_KEY=sk-你的key
WORKX_MODEL=deepseek-flash
