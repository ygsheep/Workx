# Build output directories
build/
build-wsl/
build_Linux/
_build/
vcpkg_installed/
.vcpkg/

example/cc/
example/DeepSeek-Reasonix/
example/deepseek-harness/

# IDE and editor directories
.idea/
.trae/
.vscode/

# Build artifacts
*.exe
*.lib
*.pdb
*.obj
*.o
*.out
*.dll
*.a

# CMake generated files
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake
install_manifest.txt

# Visual Studio
.vs/
*.user

# Build logs and temp files
*.log
*.tmp
*.bak
*.swp
.DS_Store

# Configuration files (may contain user-specific settings)
workx_session.json
config.json
*.env

# Runtime-generated history file (created by Terminal in home dir)
.workx_history

# models.dev catalog data (large local test fixtures, ~17MB)
models-*.json

# Test outputs
tests/*.log
tests/*.out

# Vendor external binaries (downloaded by scripts/fetch-ripgrep.py)
vendor/ripgrep/
# Vendor external binaries (downloaded by scripts/fetch-jq.py)
vendor/jq/

# Generated icon artifacts (from src/icon.png via scripts/convert_icon.py)
# 源图 src/icon.png 入库，产物 ico/icns 由 CMake 配置阶段生成
src/icon.ico
src/icon.icns

# Transient artifacts (script/tooling leftovers)
# fetch_ts_grammars.py 抓取 wiki 的临时缓存
/_wiki_parsers.md
# Python 脚本缓存（gen/fetch_ts_grammars.py 等）
__pycache__/
# worktree/脚本验证残留目录
/.claude/tmp/
# 误拉取的 grammar submodule 残留（项目示例目录是单数 example/，此处为复数根目录残留）
/examples/

# 发布打包产物（scripts/package_release.py 输出）
/dist/

# WiX 构建中间产物与暂存目录（scripts/build-msi.ps1 可再生成）
/scripts/wixobj/
/scripts/staging/
/scripts/*.wixpdb

# 运行时生成的窗口布局文件（不提交，避免每次运行产生差异）
imgui.ini

# 开发/规划辅助文件（不进入发布源码包；本地仍保留）
/.claude/
/plan/
/AGENT.md

# 独立发布的 workx-tap 仓库（tools/session-trace），由 workx-tap 独立 git 仓库管理
# 根仓库不跟踪该目录，避免嵌套 gitlink / 内容分叉
/tools/session-trace/

# nix build output symlink
/result

# 采集器自检样例：scripts/harness/fixtures/ 下的 .log 是手工构造的样例（非真实日志），
# 必须入库，否则 --self-test 在干净 clone 上会缺日志证据而失真（上面 *.log 规则的取反）
!scripts/harness/fixtures/*.log

# Harbor / Terminal-Bench 跑分产物（jobs/<job-id>/：reward.txt、ctrf.json、轨迹）
# 每次跑分都会新建一个时间戳目录，体积随 trials 增长，不入库
/jobs/

# CTest 在仓库根跑时残留的临时产物（Testing/Temporary/），不入仓
/Testing/
